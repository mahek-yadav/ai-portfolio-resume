# Backend Environment Configuration

# Flask Server Port (using 5001 to avoid macOS AirPlay conflict on 5000)
PORT=5001
FLASK_ENV=development

# Google Gemini API Key
# Obtain free from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets API Integration
# 1. Path to your downloaded service account JSON key file (relative or absolute)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# 2. Spreadsheet ID from the URL of your Google Sheet
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_google_spreadsheet_id_here
